# Rehearsal image: the submission image plus what only rehearsal needs.
#
# NEVER UPLOAD THIS IMAGE. It exists only to rehearse on CyberEDU's practice
# catalogue from inside the same toolchain the contest runs.
#
#   docker build -f Dockerfile.contest   -t ctf-harness:latest .
#   docker build -f Dockerfile.rehearsal -t ctf-harness:rehearsal .
#   docker run --rm --cap-add NET_ADMIN -e CYBEREDU_SESSION_COOKIE -e OPENAI_API_KEY ... \
#     ctf-harness:rehearsal --challenge <id>
#
# The base image already carries CyberEDU's MCP server (/opt/cyberedu-mcp) and
# the mcp client library (scripts/image_extras.sh), so this adds only the egress
# lockdown (harness/egress.py): iptables, and the settings that select the
# platform and turn the lockdown on. The lockdown needs `--cap-add NET_ADMIN`;
# without it the run stops before the agent starts (fail closed).
ARG BASE=ctf-harness:latest
FROM ${BASE}
RUN apt-get update && apt-get install -y --no-install-recommends iptables \
 && rm -rf /var/lib/apt/lists/*
ENV CTF_CYBEREDU_MCP_PYTHON=/opt/cyberedu-mcp/bin/python \
    CTF_PLATFORM=cyberedu \
    CTF_EGRESS_LOCKDOWN=1
