# Contest settings. The one file to edit on the day; it is baked into the image
# and read at start-up (harness/envfile.py). Anything set in the real
# environment (docker run -e, export) overrides a line here.
#
# NEVER put a key here. The image is the submission and the organizers read it.
# Format: NAME=value; `#` starts a comment; ${OTHER} is replaced from the env.

# --- model: the three required inputs --------------------------------------
CTF_BACKEND=openai
# OPENAI_BASE_URL=http://10.0.0.5:8000/v1
# CTF_FAST_MODEL=model-id-they-announce
# OPENAI_API_KEY is injected at run time; never set it here.
# If they inject under other names, map them:
# OPENAI_BASE_URL=${THEIR_URL_VAR}/v1
# OPENAI_API_KEY=${THEIR_KEY_VAR}
# CTF_STRONG_MODEL=                   # defaults to the fast model's role
# CTF_OPENAI_SEND_EFFORT=1            # only if the model accepts reasoning_effort
# CTF_MODEL_TIMEOUT=300               # seconds for one model request
# CTF_VISION=0                        # if preflight check 7 says the model is blind

# --- limits, once announced -------------------------------------------------
# CTF_TOTAL_SECONDS=1700              # a little under their per-run time limit
# CTF_TOTAL_TOKENS=2000000            # their per-run token limit
# CTF_MAX_OUTPUT_TOKENS=8192          # model's max output tokens
# CTF_MIN_OUTPUT_TOKENS=8192          # if preflight check 6 says the model reasons (rehearsal value)
# CTF_LADDER_DEPTHS=12,25,40,60       # turns per rung; size to the time limit
# CTF_TOP_RUNG_RESTARTS=6             # clean-context restarts once the ladder is climbed
# CTF_FRESH_CONTEXT=1                 # also restart clean at every rung change
# CTF_HISTORY_SOFT_CHARS=40000        # lower for a small context window
# CTF_HISTORY_HARD_CHARS=160000

# --- flags -------------------------------------------------------------------
# Once the format is confirmed, match it exactly; this removes lookalikes at
# the source. For CTF{sha256} flags, with or without a prefix such as DCTF:
# CTF_FLAG_REGEX=(?i)(?<![a-z0-9])[a-z]{0,8}ctf\{[0-9a-f]{64}\}
# CTF_PENALIZE_WRONG=1                # only if wrong flags cost points
# CTF_SUBMIT_MIN_INTERVAL=1.0         # seconds between two submissions

# --- the target ----------------------------------------------------------------
# service: only the host:port given (default; right on shared infrastructure).
# host:    every port on the target host (the challenge is a whole machine).
# any:     no guard, no scope line in the prompt.
# CTF_TARGET_SCOPE=service

# --- platform ----------------------------------------------------------------
# CTF_PLATFORM=harness.platforms.starter_kit:StarterKitPlatform
# CTF_CHALLENGE_ID=

# For CyberEDU's own MCP server (already in the image, see HANDOFF.md):
# CTF_PLATFORM=cyberedu
# CTF_CONTEST_ID=contest-slug
# CYBEREDU_SESSION_COOKIE is injected at run time; never set it here.

# --- where the agent works -----------------------------------------------------
# Outside the harness tree, so a wandering `ls ..` finds nothing of the runner.
# If either is unwritable the harness falls back to a temporary directory.
CTF_WORK_ROOT=/tmp/ctf-work
CTF_RUN_DIR=/var/tmp/ctf-logs

# --- logging -----------------------------------------------------------------
# Mirror the event log to stderr so it shows in the container's logs.
CTF_LOG_MIRROR=1
