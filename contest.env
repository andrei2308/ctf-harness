# Contest settings. The one file to edit on the day; it is baked into the image
# and read at start-up (harness/envfile.py). Anything set in the real
# environment (docker run -e, export) overrides a line here.
#
# NEVER put a key here. The image is the submission and the organizers read it.
# Format: NAME=value; `#` starts a comment; ${OTHER} is replaced from the env.

# === DefCamp 2026 Agentic CTF (AISafe kit), filled in on 20 November =========
# Inside a run the platform's own variables are mapped automatically
# (harness/platforms/starter_kit.py, bootstrap): GATEWAY_URL -> OPENAI_BASE_URL,
# RUN_TOKEN -> the X-Run-Token header, TIME_LIMIT_SECONDS -> CTF_TOTAL_SECONDS
# (less 30 s, then followed live from GET /health), and the platform adapter.
# One run's settings can be changed without a new upload: a line
# `@set CTF_NAME=value` in the run's INSTRUCTIONS overrides this file.
#
# The model is Qwen 3.8 27B at reasoning effort medium, fixed by the gateway.
# It allows 8192 output tokens a call but cuts a call at 180 s and then returns
# NOTHING. Measured in two Morse Relay runs: the model writes about 42 tokens a
# second, and a call can first wait up to 90 s in the gateway's queue. So 8192
# tokens cannot finish in time (two of eleven calls died that way in the first
# run), while 4000 does even after a long wait, and still holds a full solve
# script with its reasoning (the largest reply of the solved run: 3358 tokens).
CTF_MAX_OUTPUT_TOKENS=4000
CTF_MIN_OUTPUT_TOKENS=4000
# A run is a dozen turns, not dozens: no separate planning turn.
CTF_PLAN_FIRST=0
# The gateway cuts a call at 180 s and answers 503; wait a little longer than
# that, so its answer arrives instead of our own timeout (the kit waits 240 s).
CTF_MODEL_TIMEOUT=240
# The kit's gateway keeps only the text of a message (its code drops picture
# parts), so assume the event's does too: no view_image tool.
CTF_VISION=0
# Flags are generated per run: flag{32 hex}. Matching exactly keeps lookalikes
# from being submitted; a wrong flag starts a 10 s cooldown for the whole team.
CTF_FLAG_REGEX=flag\{[0-9a-f]{32}\}
# ==============================================================================

# --- model: the three required inputs --------------------------------------
CTF_BACKEND=openai
# OPENAI_BASE_URL=http://10.0.0.5:8000/v1
# CTF_FAST_MODEL=model-id-they-announce
# OPENAI_API_KEY is injected at run time; never set it here.
# If they inject under other names, map them:
# OPENAI_BASE_URL=${THEIR_URL_VAR}/v1
# OPENAI_API_KEY=${THEIR_KEY_VAR}
# CTF_STRONG_MODEL=                   # defaults to the fast model's role
# Reasoning effort: OFF. Measured 2026-11-17 with GLM 5.3 Flash (offline suite):
# it honours reasoning_effort (median turn 3.7 s / 83 output tokens, against
# 6-16 s / 156-675 without), but erratically: 3 of 4 runs solved fast, 1
# collapsed on a challenge that always solves without it (89 shallow turns,
# 7 wrong flags, token cap). A lever only if the time limit is very short.
# CTF_OPENAI_SEND_EFFORT=1
#
# One model request: 180 s (code default 300). GLM over both rounds (80 runs,
# 1,986 turns): median 9 s a turn; output ~42 tokens/s (p10 31, p90 51), so a
# full 8192-token reply takes 130-200 s, and only 7 turns ever ran to that cap.
# 11 calls ran to the full limit, all at an 8192 cap: endpoint stalls, not
# long replies. In 6 of their 7 episodes the same request, sent again,
# answered in 8-126 s (392-4,743 tokens). A stall is cut sooner at 180 s and
# the next call usually answers. Re-check against the contest model's
# preflight timings.
# CTF_MODEL_TIMEOUT=180               # superseded for the contest: see the top
#
# The prompt asks for batched steps ("Work efficiently" in specialists.py).
# Measured old vs new on the offline suite (2 runs x 6 challenges each): tool
# calls per turn 1.13 vs 1.12, i.e. no effect; solve rate 10/12 both. Kept:
# it did not make results worse.
# CTF_VISION=0                        # if preflight check 7 says the model is blind

# --- limits, once announced -------------------------------------------------
# CTF_TOTAL_SECONDS=1700              # a little under their per-run time limit
# CTF_TOTAL_TOKENS=2000000            # their per-run token limit
# CTF_MAX_OUTPUT_TOKENS=8192          # the model's max output tokens, AND no more than
#                                     # it can produce inside CTF_MODEL_TIMEOUT: a reply
#                                     # that outlasts the limit returns nothing. Preflight
#                                     # check 8 prints the value that fits (never below
#                                     # CTF_MIN_OUTPUT_TOKENS: the cap wins over the floor).
#                                     # GLM: no timeout came from a long reply (above),
#                                     # so none set.
# CTF_MIN_OUTPUT_TOKENS=8192          # if preflight check 6 says the model reasons:
#                                     # with GLM, 4 of ~600 turns were cut at 8192
# CTF_LADDER_DEPTHS=12,25,40,60       # turns per rung; size to the time limit
# CTF_TOP_RUNG_RESTARTS=6             # clean-context restarts once the ladder is climbed
# CTF_FRESH_CONTEXT=1                 # also restart clean at every rung change. OFF:
#                                     # same 21 turns took 677 s instead of 345 s
#                                     # (a handover note + a plan per clean context)
# CTF_HISTORY_SOFT_CHARS=40000        # lower for a small context window
# CTF_HISTORY_HARD_CHARS=160000

# --- flags -------------------------------------------------------------------
# Once the format is confirmed, match it exactly; this removes lookalikes at
# the source. For CTF{sha256} flags, with or without a prefix such as DCTF:
# CTF_FLAG_REGEX=(?i)(?<![a-z0-9])[a-z]{0,8}ctf\{[0-9a-f]{64}\}
# CTF_PENALIZE_WRONG=1                # only if wrong flags cost points
# CTF_SUBMIT_MIN_INTERVAL=1.0         # seconds between two submissions
# CTF_MAX_GUESSES=8                   # ungrounded guesses per challenge when wrong flags
#                                     # are free (22 went out on one challenge before)

# --- the target ----------------------------------------------------------------
# service: only the host:port given (default; right on shared infrastructure).
# host:    every port on the target host (the challenge is a whole machine).
# any:     no guard, no scope line in the prompt.
# CTF_TARGET_SCOPE=service

# --- platform ----------------------------------------------------------------
# CTF_PLATFORM=harness.platforms.starter_kit:StarterKitPlatform
# CTF_CHALLENGE_ID=

# For CyberEDU's own MCP server (already in the image, see HANDOFF.md):
# CTF_PLATFORM=cyberedu
# CTF_CONTEST_ID=contest-slug
# CYBEREDU_SESSION_COOKIE is injected at run time; never set it here.

# --- where the agent works -----------------------------------------------------
# Outside the harness tree, so a wandering `ls ..` finds nothing of the runner.
# If either is unwritable the harness falls back to a temporary directory.
CTF_WORK_ROOT=/tmp/ctf-work
CTF_RUN_DIR=/var/tmp/ctf-logs

# --- logging -----------------------------------------------------------------
# Mirror the event log to stderr so it shows in the container's logs.
CTF_LOG_MIRROR=1
